  "components": {
    "schemas": {
      "BaselineChangeOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "field": {
            "$ref": "#/components/schemas/BaselineKey"
          },
          "before": {
            "$ref": "#/components/schemas/SnapshotOut"
          },
          "after": {
            "$ref": "#/components/schemas/SnapshotOut"
          },
          "by": {
            "type": "string",
            "enum": [
              "Noivo",
              "Noiva"
            ],
            "title": "By"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "field",
          "before",
          "after",
          "by",
          "at"
        ],
        "title": "BaselineChangeOut"
      },
      "BaselineKey": {
        "type": "string",
        "enum": [
          "date",
          "city",
          "format",
          "size",
          "ceiling",
          "ceremony"
