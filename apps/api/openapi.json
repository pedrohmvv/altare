                "type": "null"
              }
            ],
            "title": "Note"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version",
            "description": "A versão que a tela viu; divergir dá 409."
          },
          "value": {
            "$ref": "#/components/schemas/CeilingValueSchema"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "value"
        ],
        "title": "CeilingFieldIn"
      },
      "CeilingFieldOut": {
        "properties": {
          "status": {
