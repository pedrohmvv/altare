          },
          "ceremony": {
            "$ref": "#/components/schemas/CeremonyFieldOut"
          }
        },
        "type": "object",
        "required": [
          "date",
          "city",
          "format",
          "size",
          "ceiling",
          "ceremony"
        ],
        "title": "BaselineOut"
      },
      "Body_upload_file": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_file"
      },
