{
  "skillListingBudgetFraction": 0.02,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sed -n '/<!-- skills-map:start -->/,/<!-- skills-map:end -->/p' \"$CLAUDE_PROJECT_DIR/AGENTS.md\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(git add *)", "Bash(git commit *)", "Bash(git push *)", "Bash(gh pr create *)", "Bash(gh pr merge *)"],
    "deny":  ["Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push * --force*)", "Bash(git push * -f*)"]
}

}
